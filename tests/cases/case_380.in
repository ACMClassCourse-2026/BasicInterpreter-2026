10 DIM C(5001) AS INTEGER
20 DIM P AS INTEGER = 2
30 DIM M AS INTEGER
40 DIM COUNT AS INTEGER = 0
50 DIM TOTAL AS INTEGER = 0
60 WHILE P * P <= 5000
70 IF C(P) = 0 THEN
80 LET M = P * P
90 WHILE M <= 5000
100 LET C(M) = 1
110 LET M = M + P
120 WEND
130 END IF
140 LET P = P + 1
150 WEND
160 FOR I = 2 TO 5000
170 IF C(I) = 0 THEN
180 LET COUNT = COUNT + 1
190 LET TOTAL = TOTAL + I
200 END IF
210 NEXT I
220 PRINT COUNT
230 PRINT TOTAL
240 PRINT C(4999)
RUN
QUIT
