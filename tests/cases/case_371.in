10 DIM A(256) AS INTEGER
20 DIM LS(256) AS INTEGER
30 DIM RS(256) AS INTEGER
40 DIM N AS INTEGER = 256
50 DIM TOP AS INTEGER = 0
60 DIM LO AS INTEGER
70 DIM HI AS INTEGER
80 DIM I AS INTEGER
90 DIM J AS INTEGER
100 DIM PIVOT AS INTEGER
110 DIM TEMP AS INTEGER
120 DIM OK AS INTEGER = 1
130 DIM CHECK AS INTEGER = 0
140 FOR P = 0 TO N - 1
150 LET A(P) = (P * 89 + 31) MOD 1009
160 NEXT P
170 LET LS(0) = 0
180 LET RS(0) = N - 1
190 WHILE TOP >= 0
200 LET LO = LS(TOP)
210 LET HI = RS(TOP)
220 LET TOP = TOP - 1
230 LET PIVOT = A((LO + HI) \ 2)
240 LET I = LO
250 LET J = HI
260 WHILE I <= J
270 WHILE A(I) < PIVOT
280 LET I = I + 1
290 WEND
300 WHILE A(J) > PIVOT
310 LET J = J - 1
320 WEND
330 IF I <= J THEN
340 LET TEMP = A(I)
350 LET A(I) = A(J)
360 LET A(J) = TEMP
370 LET I = I + 1
380 LET J = J - 1
390 END IF
400 WEND
410 IF LO < J THEN
420 LET TOP = TOP + 1
430 LET LS(TOP) = LO
440 LET RS(TOP) = J
450 END IF
460 IF I < HI THEN
470 LET TOP = TOP + 1
480 LET LS(TOP) = I
490 LET RS(TOP) = HI
500 END IF
510 WEND
520 FOR P = 1 TO N - 1
530 IF A(P) < A(P - 1) THEN
540 LET OK = 0
550 END IF
560 NEXT P
570 FOR P = 0 TO N - 1
580 LET CHECK = CHECK + A(P) * ((P MOD 5) + 1)
590 NEXT P
600 PRINT OK
610 PRINT A(0)
620 PRINT A(N - 1)
630 PRINT CHECK
RUN
QUIT
