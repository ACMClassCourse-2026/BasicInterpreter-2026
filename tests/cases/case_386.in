10 DIM A(300) AS INTEGER
20 DIM DP(300) AS INTEGER
30 DIM BEST AS INTEGER = 1
40 DIM CHECK AS INTEGER = 0
50 FOR I = 0 TO 299
60 LET A(I) = (I * 73 + I * I * 7 + 11) MOD 1009
70 LET DP(I) = 1
80 FOR J = 0 TO I - 1
90 IF A(J) < A(I) AND DP(J) + 1 > DP(I) THEN
100 LET DP(I) = DP(J) + 1
110 END IF
120 NEXT J
130 IF DP(I) > BEST THEN
140 LET BEST = DP(I)
150 END IF
160 LET CHECK = CHECK + DP(I)
170 NEXT I
180 PRINT BEST
190 PRINT CHECK
RUN
QUIT
