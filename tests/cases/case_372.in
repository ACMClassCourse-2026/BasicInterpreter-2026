10 DIM H(512) AS INTEGER
20 DIM OUT(512) AS INTEGER
30 DIM SIZE AS INTEGER = 0
40 DIM POS AS INTEGER
50 DIM PARENT AS INTEGER
60 DIM CHILD AS INTEGER
70 DIM TEMP AS INTEGER
80 DIM ACTIVE AS INTEGER
90 DIM OK AS INTEGER = 1
100 DIM CHECK AS INTEGER = 0
110 FOR I = 0 TO 511
120 LET POS = SIZE
130 LET H(POS) = (I * 97 + 43) MOD 2003
140 LET SIZE = SIZE + 1
150 LET ACTIVE = 1
160 WHILE POS > 0 AND ACTIVE = 1
170 LET PARENT = (POS - 1) \ 2
180 IF H(PARENT) < H(POS) THEN
190 LET TEMP = H(PARENT)
200 LET H(PARENT) = H(POS)
210 LET H(POS) = TEMP
220 LET POS = PARENT
230 ELSE
240 LET ACTIVE = 0
250 END IF
260 WEND
270 NEXT I
280 FOR I = 0 TO 511
290 LET OUT(I) = H(0)
300 LET SIZE = SIZE - 1
310 IF SIZE > 0 THEN
320 LET H(0) = H(SIZE)
330 LET POS = 0
340 LET ACTIVE = 1
350 WHILE ACTIVE = 1
360 LET CHILD = POS * 2 + 1
370 IF CHILD >= SIZE THEN
380 LET ACTIVE = 0
390 ELSE
400 IF CHILD + 1 < SIZE AND H(CHILD + 1) > H(CHILD) THEN
410 LET CHILD = CHILD + 1
420 END IF
430 IF H(POS) < H(CHILD) THEN
440 LET TEMP = H(POS)
450 LET H(POS) = H(CHILD)
460 LET H(CHILD) = TEMP
470 LET POS = CHILD
480 ELSE
490 LET ACTIVE = 0
500 END IF
510 END IF
520 WEND
530 END IF
540 NEXT I
550 FOR I = 1 TO 511
560 IF OUT(I) > OUT(I - 1) THEN
570 LET OK = 0
580 END IF
590 NEXT I
600 FOR I = 0 TO 511
610 LET CHECK = CHECK + OUT(I) * ((I MOD 3) + 1)
620 NEXT I
630 PRINT OK
640 PRINT OUT(0)
650 PRINT OUT(511)
660 PRINT CHECK
RUN
QUIT
