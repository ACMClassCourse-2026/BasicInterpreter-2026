10 DIM G(64, 64) AS INTEGER
20 DIM SEEN(64) AS INTEGER
30 DIM S(4096) AS INTEGER
40 DIM TOP AS INTEGER = 0
50 DIM U AS INTEGER
60 DIM V AS INTEGER
70 DIM COUNT AS INTEGER = 0
80 DIM CHECK AS INTEGER = 0
90 FOR I = 0 TO 63
100 LET V = (I + 1) MOD 64
110 LET G(I, V) = 1
120 LET G(V, I) = 1
130 LET V = (I * 7 + 3) MOD 64
140 LET G(I, V) = 1
150 LET G(V, I) = 1
160 NEXT I
170 LET S(0) = 0
180 WHILE TOP >= 0
190 LET U = S(TOP)
200 LET TOP = TOP - 1
210 IF SEEN(U) = 0 THEN
220 LET SEEN(U) = 1
230 LET COUNT = COUNT + 1
240 LET CHECK = CHECK + COUNT * U
250 FOR J = 63 TO 0 STEP -1
260 IF G(U, J) = 1 AND SEEN(J) = 0 THEN
270 LET TOP = TOP + 1
280 LET S(TOP) = J
290 END IF
300 NEXT J
310 END IF
320 WEND
330 PRINT COUNT
340 PRINT CHECK
RUN
QUIT
