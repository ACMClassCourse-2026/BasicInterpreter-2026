10 DIM A(20, 20) AS INTEGER
20 DIM B(20, 20) AS INTEGER
30 DIM C(20, 20) AS INTEGER
40 DIM CHECK AS INTEGER = 0
50 FOR I = 0 TO 19
60 FOR J = 0 TO 19
70 LET A(I, J) = (I * 7 + J * 3 + 1) MOD 10
80 LET B(I, J) = (I * 5 + J * 11 + 2) MOD 10
90 NEXT J
100 NEXT I
110 FOR I = 0 TO 19
120 FOR J = 0 TO 19
130 FOR K = 0 TO 19
140 LET C(I, J) = C(I, J) + A(I, K) * B(K, J)
150 NEXT K
160 LET CHECK = CHECK + C(I, J) * (((I + J) MOD 5) + 1)
170 NEXT J
180 NEXT I
190 PRINT C(0, 0)
200 PRINT C(19, 19)
210 PRINT CHECK
RUN
QUIT
