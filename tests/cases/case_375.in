10 DIM G(80, 80) AS INTEGER
20 DIM D(80) AS INTEGER
30 DIM USED(80) AS INTEGER
40 DIM INF AS INTEGER = 100000000
50 DIM U AS INTEGER
60 DIM BEST AS INTEGER
70 DIM W AS INTEGER
80 DIM TOTAL AS INTEGER = 0
90 FOR I = 0 TO 79
100 LET D(I) = INF
110 FOR J = 0 TO 79
120 IF I <> J AND ((I * 17 + J * 13) MOD 11) < 3 THEN
130 LET G(I, J) = ((I * 7 + J * 5) MOD 20) + 1
140 END IF
150 NEXT J
160 IF I < 79 THEN
170 LET G(I, I + 1) = 1
180 END IF
190 NEXT I
200 LET D(0) = 0
210 FOR K = 0 TO 79
220 LET U = -1
230 LET BEST = INF
240 FOR I = 0 TO 79
250 IF USED(I) = 0 AND D(I) < BEST THEN
260 LET BEST = D(I)
270 LET U = I
280 END IF
290 NEXT I
300 LET USED(U) = 1
310 FOR J = 0 TO 79
320 LET W = G(U, J)
330 IF W > 0 AND D(U) + W < D(J) THEN
340 LET D(J) = D(U) + W
350 END IF
360 NEXT J
370 NEXT K
380 FOR I = 0 TO 79
390 LET TOTAL = TOTAL + D(I)
400 NEXT I
410 PRINT TOTAL
420 PRINT D(79)
RUN
QUIT
