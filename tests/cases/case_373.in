10 DIM G(64, 64) AS INTEGER
20 DIM D(64) AS INTEGER
30 DIM Q(64) AS INTEGER
40 DIM HEAD AS INTEGER = 0
50 DIM TAIL AS INTEGER = 1
60 DIM U AS INTEGER
70 DIM V AS INTEGER
80 DIM OTHER AS INTEGER
90 DIM TOTAL AS INTEGER = 0
100 FOR I = 0 TO 63
110 LET D(I) = -1
120 LET V = (I + 1) MOD 64
130 LET G(I, V) = 1
140 LET G(V, I) = 1
150 LET V = (I * 7 + 3) MOD 64
160 LET G(I, V) = 1
170 LET G(V, I) = 1
180 NEXT I
190 LET D(0) = 0
200 LET Q(0) = 0
210 WHILE HEAD < TAIL
220 LET U = Q(HEAD)
230 LET HEAD = HEAD + 1
240 FOR J = 0 TO 63
250 IF G(U, J) = 1 AND D(J) < 0 THEN
260 LET D(J) = D(U) + 1
270 LET Q(TAIL) = J
280 LET TAIL = TAIL + 1
290 END IF
300 NEXT J
310 WEND
320 FOR I = 0 TO 63
330 LET TOTAL = TOTAL + D(I)
340 NEXT I
350 PRINT TAIL
360 PRINT TOTAL
370 PRINT D(63)
RUN
QUIT
