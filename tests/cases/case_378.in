10 DIM P(1024) AS INTEGER
20 DIM LEFT AS INTEGER
30 DIM RIGHT AS INTEGER
40 DIM RA AS INTEGER
50 DIM RB AS INTEGER
60 DIM CUR AS INTEGER
70 DIM NEXTV AS INTEGER
80 DIM ROOTS AS INTEGER = 0
90 DIM CHECK AS INTEGER = 0
100 FOR I = 0 TO 1023
110 LET P(I) = I
120 NEXT I
130 FOR OP = 0 TO 2047
140 LET LEFT = (OP * 37 + 11) MOD 1024
150 LET RIGHT = (OP * 91 + 7) MOD 1024
160 LET RA = LEFT
170 WHILE P(RA) <> RA
180 LET RA = P(RA)
190 WEND
200 LET CUR = LEFT
210 WHILE P(CUR) <> CUR
220 LET NEXTV = P(CUR)
230 LET P(CUR) = RA
240 LET CUR = NEXTV
250 WEND
260 LET RB = RIGHT
270 WHILE P(RB) <> RB
280 LET RB = P(RB)
290 WEND
300 LET CUR = RIGHT
310 WHILE P(CUR) <> CUR
320 LET NEXTV = P(CUR)
330 LET P(CUR) = RB
340 LET CUR = NEXTV
350 WEND
360 IF RA <> RB THEN
370 IF RA < RB THEN
380 LET P(RB) = RA
390 ELSE
400 LET P(RA) = RB
410 END IF
420 END IF
430 NEXT OP
440 FOR I = 0 TO 1023
450 LET RA = I
460 WHILE P(RA) <> RA
470 LET RA = P(RA)
480 WEND
490 LET P(I) = RA
500 LET CHECK = CHECK + RA
510 IF RA = I THEN
520 LET ROOTS = ROOTS + 1
530 END IF
540 NEXT I
550 PRINT ROOTS
560 PRINT CHECK
RUN
QUIT
