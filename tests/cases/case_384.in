10 DIM A(4096) AS INTEGER
20 DIM P(4097) AS INTEGER
30 DIM LEFT AS INTEGER
40 DIM RIGHT AS INTEGER
50 DIM LENGTH AS INTEGER
60 DIM VALUE AS INTEGER
70 DIM CHECK AS INTEGER = 0
80 FOR I = 0 TO 4095
90 LET A(I) = (I * 53 + 7) MOD 1000
100 LET P(I + 1) = P(I) + A(I)
110 NEXT I
120 FOR Q = 0 TO 255
130 LET LEFT = (Q * 31) MOD 4096
140 LET LENGTH = (Q * 17) MOD 200
150 LET RIGHT = LEFT + LENGTH + 1
160 IF RIGHT > 4096 THEN
170 LET RIGHT = 4096
180 END IF
190 LET VALUE = P(RIGHT) - P(LEFT)
200 LET CHECK = (CHECK + VALUE) MOD 1000000000
210 NEXT Q
220 PRINT CHECK
230 PRINT VALUE
240 PRINT P(4096)
RUN
QUIT
