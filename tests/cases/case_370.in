10 DIM A(256) AS INTEGER
20 DIM T(256) AS INTEGER
30 DIM N AS INTEGER = 256
40 DIM WIDTH AS INTEGER = 1
50 DIM LEFT AS INTEGER
60 DIM MID AS INTEGER
70 DIM RIGHT AS INTEGER
80 DIM I AS INTEGER
90 DIM J AS INTEGER
100 DIM K AS INTEGER
110 DIM OK AS INTEGER = 1
120 DIM CHECK AS INTEGER = 0
130 FOR P = 0 TO N - 1
140 LET A(P) = (P * 73 + 19) MOD 997
150 NEXT P
160 WHILE WIDTH < N
170 LET LEFT = 0
180 WHILE LEFT < N
190 LET MID = LEFT + WIDTH
200 IF MID > N THEN
210 LET MID = N
220 END IF
230 LET RIGHT = LEFT + WIDTH + WIDTH
240 IF RIGHT > N THEN
250 LET RIGHT = N
260 END IF
270 LET I = LEFT
280 LET J = MID
290 LET K = LEFT
300 WHILE K < RIGHT
310 IF I >= MID THEN
320 LET T(K) = A(J)
330 LET J = J + 1
340 ELSEIF J >= RIGHT THEN
350 LET T(K) = A(I)
360 LET I = I + 1
370 ELSEIF A(I) <= A(J) THEN
380 LET T(K) = A(I)
390 LET I = I + 1
400 ELSE
410 LET T(K) = A(J)
420 LET J = J + 1
430 END IF
440 LET K = K + 1
450 WEND
460 LET K = LEFT
470 WHILE K < RIGHT
480 LET A(K) = T(K)
490 LET K = K + 1
500 WEND
510 LET LEFT = LEFT + WIDTH + WIDTH
520 WEND
530 LET WIDTH = WIDTH * 2
540 WEND
550 FOR P = 1 TO N - 1
560 IF A(P) < A(P - 1) THEN
570 LET OK = 0
580 END IF
590 NEXT P
600 FOR P = 0 TO N - 1
610 LET CHECK = CHECK + A(P) * ((P MOD 7) + 1)
620 NEXT P
630 PRINT OK
640 PRINT A(0)
650 PRINT A(N - 1)
660 PRINT CHECK
RUN
QUIT
