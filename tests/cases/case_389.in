10 DIM G(64, 64) AS INTEGER
20 DIM KEY(64) AS INTEGER
30 DIM USED(64) AS INTEGER
40 DIM INF AS INTEGER = 100000000
50 DIM U AS INTEGER
60 DIM BEST AS INTEGER
70 DIM WEIGHT AS INTEGER
80 DIM TOTAL AS INTEGER = 0
90 FOR I = 0 TO 63
100 LET KEY(I) = INF
110 FOR J = I + 1 TO 63
120 LET WEIGHT = ((I * 31 + J * 17) MOD 100) + 1
130 LET G(I, J) = WEIGHT
140 LET G(J, I) = WEIGHT
150 NEXT J
160 NEXT I
170 LET KEY(0) = 0
180 FOR K = 0 TO 63
190 LET U = -1
200 LET BEST = INF
210 FOR I = 0 TO 63
220 IF USED(I) = 0 AND KEY(I) < BEST THEN
230 LET BEST = KEY(I)
240 LET U = I
250 END IF
260 NEXT I
270 LET USED(U) = 1
280 LET TOTAL = TOTAL + KEY(U)
290 FOR J = 0 TO 63
300 IF USED(J) = 0 AND G(U, J) < KEY(J) THEN
310 LET KEY(J) = G(U, J)
320 END IF
330 NEXT J
340 NEXT K
350 PRINT TOTAL
360 PRINT KEY(63)
RUN
QUIT
