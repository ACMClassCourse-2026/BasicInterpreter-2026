10 DIM D(24, 24) AS INTEGER
20 DIM INF AS INTEGER = 100000000
30 DIM TOTAL AS INTEGER = 0
40 FOR I = 0 TO 23
50 FOR J = 0 TO 23
60 IF I = J THEN
70 LET D(I, J) = 0
80 ELSE
90 LET D(I, J) = INF
100 END IF
110 IF I <> J AND ((I * 17 + J * 13) MOD 11) < 3 THEN
120 LET D(I, J) = ((I * 7 + J * 5) MOD 20) + 1
130 END IF
140 NEXT J
150 IF I < 23 THEN
160 LET D(I, I + 1) = 1
170 END IF
180 NEXT I
190 FOR K = 0 TO 23
200 FOR I = 0 TO 23
210 FOR J = 0 TO 23
220 IF D(I, K) + D(K, J) < D(I, J) THEN
230 LET D(I, J) = D(I, K) + D(K, J)
240 END IF
250 NEXT J
260 NEXT I
270 NEXT K
280 FOR J = 0 TO 23
290 LET TOTAL = TOTAL + D(0, J)
300 NEXT J
310 PRINT TOTAL
320 PRINT D(0, 23)
RUN
QUIT
