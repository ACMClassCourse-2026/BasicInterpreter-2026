10 DIM A(1000) AS INTEGER
20 DIM B(1000) AS INTEGER
30 DIM C(10) AS INTEGER
40 DIM EXP AS INTEGER = 1
50 DIM DIGIT AS INTEGER
60 DIM OK AS INTEGER = 1
70 DIM CHECK AS INTEGER = 0
80 FOR I = 0 TO 999
90 LET A(I) = (I * 7919 + I * I * 13 + 97) MOD 100000
100 NEXT I
110 WHILE EXP <= 10000
120 FOR D = 0 TO 9
130 LET C(D) = 0
140 NEXT D
150 FOR I = 0 TO 999
160 LET DIGIT = (A(I) \ EXP) MOD 10
170 LET C(DIGIT) = C(DIGIT) + 1
180 NEXT I
190 FOR D = 1 TO 9
200 LET C(D) = C(D) + C(D - 1)
210 NEXT D
220 FOR I = 999 TO 0 STEP -1
230 LET DIGIT = (A(I) \ EXP) MOD 10
240 LET C(DIGIT) = C(DIGIT) - 1
250 LET B(C(DIGIT)) = A(I)
260 NEXT I
270 FOR I = 0 TO 999
280 LET A(I) = B(I)
290 NEXT I
300 LET EXP = EXP * 10
310 WEND
320 FOR I = 1 TO 999
330 IF A(I) < A(I - 1) THEN
340 LET OK = 0
350 END IF
360 NEXT I
370 FOR I = 0 TO 999
380 LET CHECK = (CHECK + A(I) * ((I MOD 5) + 1)) MOD 1000000000
390 NEXT I
400 PRINT OK
410 PRINT A(0)
420 PRINT A(999)
430 PRINT CHECK
RUN
QUIT
