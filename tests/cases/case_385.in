10 DIM DP(401) AS INTEGER
20 DIM W AS INTEGER
30 DIM V AS INTEGER
40 DIM C AS INTEGER
50 DIM CANDIDATE AS INTEGER
60 FOR I = 0 TO 79
70 LET W = (I * 7) MOD 20 + 1
80 LET V = (I * 13) MOD 50 + 1
90 LET C = 400
100 WHILE C >= W
110 LET CANDIDATE = DP(C - W) + V
120 IF CANDIDATE > DP(C) THEN
130 LET DP(C) = CANDIDATE
140 END IF
150 LET C = C - 1
160 WEND
170 NEXT I
180 PRINT DP(400)
190 PRINT DP(200)
RUN
QUIT
