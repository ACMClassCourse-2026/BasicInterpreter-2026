10 DIM T(1000) AS INTEGER
20 DIM P(31) AS INTEGER
30 DIM PI(31) AS INTEGER
40 DIM J AS INTEGER = 0
50 DIM COUNT AS INTEGER = 0
60 DIM FIRST AS INTEGER = -1
70 FOR I = 0 TO 999
80 LET T(I) = (I * 11 + (I \ 7) + 3) MOD 17
90 NEXT I
100 FOR I = 0 TO 30
110 LET P(I) = T(I + 417)
120 NEXT I
130 FOR I = 1 TO 30
140 WHILE J > 0 AND P(I) <> P(J)
150 LET J = PI(J - 1)
160 WEND
170 IF P(I) = P(J) THEN
180 LET J = J + 1
190 END IF
200 LET PI(I) = J
210 NEXT I
220 LET J = 0
230 FOR I = 0 TO 999
240 WHILE J > 0 AND T(I) <> P(J)
250 LET J = PI(J - 1)
260 WEND
270 IF T(I) = P(J) THEN
280 LET J = J + 1
290 END IF
300 IF J = 31 THEN
310 LET COUNT = COUNT + 1
320 IF FIRST < 0 THEN
330 LET FIRST = I - 30
340 END IF
350 LET J = PI(J - 1)
360 END IF
370 NEXT I
380 PRINT COUNT
390 PRINT FIRST
400 PRINT PI(30)
RUN
QUIT
