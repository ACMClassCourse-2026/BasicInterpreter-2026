10 DIM A(2048) AS INTEGER
20 DIM TARGET AS INTEGER
30 DIM LO AS INTEGER
40 DIM HI AS INTEGER
50 DIM MID AS INTEGER
60 DIM POS AS INTEGER
70 DIM FOUND AS INTEGER = 0
80 DIM TOTAL AS INTEGER = 0
90 FOR I = 0 TO 2047
100 LET A(I) = I * 3
110 NEXT I
120 FOR Q = 0 TO 255
130 LET TARGET = (Q * 97) MOD 6144
140 LET LO = 0
150 LET HI = 2047
160 LET POS = -1
170 WHILE LO <= HI
180 LET MID = (LO + HI) \ 2
190 IF A(MID) = TARGET THEN
200 LET POS = MID
210 LET LO = HI + 1
220 ELSEIF A(MID) < TARGET THEN
230 LET LO = MID + 1
240 ELSE
250 LET HI = MID - 1
260 END IF
270 WEND
280 IF POS >= 0 THEN
290 LET FOUND = FOUND + 1
300 LET TOTAL = TOTAL + POS
310 END IF
320 NEXT Q
330 PRINT FOUND
340 PRINT TOTAL
RUN
QUIT
