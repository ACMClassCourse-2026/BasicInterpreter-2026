10 DIM MODULUS AS LONG = 1000003
20 DIM BASE AS LONG
30 DIM E AS LONG
40 DIM RESULT AS LONG
50 DIM TOTAL AS LONG = 0
60 FOR I = 0 TO 127
70 LET BASE = (CLNG(I) * CLNG(7919) + CLNG(17)) MOD MODULUS
80 LET E = (CLNG(I) * CLNG(37) + CLNG(23)) MOD CLNG(1000)
90 LET RESULT = CLNG(1)
100 WHILE E > CLNG(0)
110 IF E MOD CLNG(2) = CLNG(1) THEN
120 LET RESULT = (RESULT * BASE) MOD MODULUS
130 END IF
140 LET BASE = (BASE * BASE) MOD MODULUS
150 LET E = E \ CLNG(2)
160 WEND
170 LET TOTAL = TOTAL + RESULT
180 NEXT I
190 PRINT TOTAL
200 PRINT RESULT
RUN
QUIT
