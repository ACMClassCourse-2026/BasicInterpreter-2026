10 DIM G(100, 100) AS INTEGER
20 DIM DEG(100) AS INTEGER
30 DIM Q(100) AS INTEGER
40 DIM HEAD AS INTEGER = 0
50 DIM TAIL AS INTEGER = 0
60 DIM U AS INTEGER
70 DIM COUNT AS INTEGER = 0
80 DIM CHECK AS INTEGER = 0
90 FOR I = 0 TO 99
100 FOR J = I + 1 TO 99
110 IF J = I + 1 OR ((I * 19 + J * 23) MOD 29) = 0 THEN
120 LET G(I, J) = 1
130 END IF
140 NEXT J
150 NEXT I
160 FOR I = 0 TO 99
170 FOR J = 0 TO 99
180 IF G(I, J) = 1 THEN
190 LET DEG(J) = DEG(J) + 1
200 END IF
210 NEXT J
220 NEXT I
230 FOR I = 0 TO 99
240 IF DEG(I) = 0 THEN
250 LET Q(TAIL) = I
260 LET TAIL = TAIL + 1
270 END IF
280 NEXT I
290 WHILE HEAD < TAIL
300 LET U = Q(HEAD)
310 LET HEAD = HEAD + 1
320 LET COUNT = COUNT + 1
330 LET CHECK = CHECK + COUNT * U
340 FOR J = 0 TO 99
350 IF G(U, J) = 1 THEN
360 LET DEG(J) = DEG(J) - 1
370 IF DEG(J) = 0 THEN
380 LET Q(TAIL) = J
390 LET TAIL = TAIL + 1
400 END IF
410 END IF
420 NEXT J
430 WEND
440 PRINT COUNT
450 PRINT CHECK
RUN
QUIT
